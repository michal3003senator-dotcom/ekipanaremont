# Ekipa na Termin – zmienne środowiskowe.
# Skopiuj do .env.local (ignorowany przez Git) i uzupełnij. Sekrety wpisujesz tylko tam i w Vercel.
# Najprościej: pnpm env:init – tworzy .env.local i sam wpisuje losowe sekrety (nic nie kopiujesz).
# Opis każdej zmiennej i skąd ją wziąć: docs/PLAN.md, sekcja 5.
# Zmienne z kolejnych faz są zakomentowane – odkomentuj je w fazie, która ich używa.

# --- Faza 1: aplikacja i baza ------------------------------------------------
# Lokalnie baza z docker-compose.yml. Staging i produkcja: Neon, połączenie przez pooler.
DATABASE_URL=postgres://ekipa:ekipa@127.0.0.1:5432/ekipa
# Neon: połączenie bezpośrednie, używane do migracji w `pnpm vercel-build`. Lokalnie zbędne.
# DATABASE_URL_UNPOOLED=
# Podpis tokenów sesji Payload, min. 32 znaki.
PAYLOAD_SECRET=
# Publiczny adres serwisu, bez ukośnika na końcu (CSRF, CORS, linki).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Faza 1: Sentry (opcjonalnie) ---------------------------------------------
# DSN projektu w organizacji z regionu UE (host *.ingest.de.sentry.io). Puste = Sentry wyłączony.
NEXT_PUBLIC_SENTRY_DSN=
# Tylko w Vercel/CI: wysyłka map źródłowych.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# --- Faza 3: szyfrowanie, zadania, pliki --------------------------------------
# Klucz AES-256-GCM pól (S), 32 bajty w base64. Zgubiony klucz = utracone dane, trzymaj kopię w menedżerze haseł.
DATA_ENCRYPTION_KEY=
# Numer bieżącej wersji klucza (start: 1).
# DATA_ENCRYPTION_KEY_VERSION=1
# Poprzednie klucze, tylko do odczytu po rotacji.
# DATA_ENCRYPTION_KEYS_PREVIOUS=
# Klucz główny HMAC (e-maile, IP, tokeny), 32 bajty w base64.
DATA_HMAC_KEY=
# Autoryzacja Vercel Cron -> zadania Payload (min. 32 znaki). Lokalnie opcjonalny.
CRON_SECRET=
# Cloudflare R2 (jurysdykcja EU).
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_PUBLIC=
# R2_BUCKET_PRIVATE=
# NEXT_PUBLIC_MEDIA_URL=

# --- Faza 4: firmy, e-maile, ochrona formularzy -------------------------------
# Podpis linków (termin, opinia, przedłużenie ogłoszenia), 32 bajty w base64 – pnpm env:init.
LINK_SIGNING_KEY=
# Brevo SMTP relay (smtp-relay.brevo.com:587). Lokalnie Mailpit z docker-compose: localhost, 1025, bez loginu.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=powiadomienia@ekipanatermin.pl
# Cloudflare Turnstile. Puste = lokalnie formularze bez widżetu (na produkcji odrzucane).
# Klucze testowe Cloudflare (zawsze przechodzą): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis (eu-central-1): limity żądań. Puste = licznik w pamięci (tylko lokalnie).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Token CEIDG z dane.biznes.gov.pl. Puste = weryfikacja przez Białą listę VAT i KRS.
CEIDG_API_TOKEN=
# Hasło konta demo@ekipanatermin.test z `pnpm seed demo` (tylko lokalnie, pnpm env:init).
SEED_DEMO_PASSWORD=

# --- Faza 5: statystyki -------------------------------------------------------
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Faza 7: web push (opcjonalnie) -------------------------------------------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
