{
  "name": "ekipanatermin",
  "version": "0.1.0",
  "private": true,
  "description": "Ekipa na Termin – katalog firm remontowych z województwa łódzkiego",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "pnpm payload migrate && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "demo": "pnpm env:init && docker compose up -d --wait --force-recreate && pnpm payload migrate && pnpm seed demo && pnpm dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "vercel-build": "DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" pnpm payload migrate && pnpm build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:e2e": "playwright test",
    "screens": "node scripts/screens.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "pnpm payload generate:types",
    "generate:importmap": "pnpm payload generate:importmap",
    "prepare": "husky",
    "env:init": "node scripts/env-init.ts",
    "seed": "pnpm payload run scripts/seed.ts",
    "teryt:build": "node scripts/teryt/build.ts",
    "rotate-key": "pnpm payload run scripts/rotate-key.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@react-email/components": "1.0.12",
    "@sentry/nextjs": "11.4.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-pl": "4.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "graphql": "16.14.2",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "payload": "3.90.2",
    "payload-totp": "3.0.6",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,scss,yml,yaml}": "prettier --write"
  }
}
